# انسخ الملف ده لـ .env وعدّل القيم
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/waseet_dev
# Milestone 3: تسجيل الدخول (JWT)
APP_ENV=dev
# خارج وضع dev لازم قيمة عشوائية 32 حرف أو أكتر:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-0123456789
JWT_EXPIRE_MINUTES=480
# Milestone 4: توكن بوت تيليجرام من @BotFather. حطه هنا على جهازك بس، ومتبعتوش لأي حد ولا ترفعه على GitHub.
TELEGRAM_BOT_TOKEN=
# واجهة Streamlit بتكلم الـ API ده
WASEET_API_URL=http://localhost:8000/api/v1
